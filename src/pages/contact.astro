---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base
  title="Contact — SSO El Paso"
  description="Contact SSO El Paso with feedback, corrections, or questions about this site. We are not the SSA."
  canonicalPath="/contact/"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />

  <header class="page-header">
    <div class="page-header-eyebrow">About this site</div>
    <div class="page-header-title-row">
      <h1>Contact</h1>
    </div>
  </header>

  <div class="article-grid-v2">
    <article class="article-main">
      <p class="article-intro">Have a correction, suggestion, or question about the site? We want to hear it.</p>

      <h2>Important note</h2>
      <p>SSO El Paso is <strong>NOT</strong> the Social Security Administration. We cannot help with your individual Social Security account, applications, benefits, or any official transactions. For those, you must contact the SSA directly:</p>

      <div class="checklist">
        <h3>Official SSA contact</h3>
        <ul>
          <li><strong>SSA national line:</strong> <a href="tel:18007721213">1-800-772-1213</a> (TTY <a href="tel:18003250778">1-800-325-0778</a>)</li>
          <li><strong>Online:</strong> <a href="https://www.ssa.gov">ssa.gov</a></li>
          <li><strong>My Social Security account:</strong> <a href="https://www.ssa.gov/myaccount/">ssa.gov/myaccount</a></li>
          <li><strong>El Paso SSA office:</strong> 11111 Gateway Blvd W, El Paso, TX 79935</li>
          <li><strong>SSA office locator:</strong> <a href="https://secure.ssa.gov/ICON/main.jsp">secure.ssa.gov/ICON/main.jsp</a></li>
        </ul>
      </div>

      <h2>Site feedback only</h2>
      <p>For corrections, suggestions, or questions about <strong>this website only</strong>, reach us at: <strong>hello@ssoelpasotx.com</strong></p>
      <p><strong>Do not send personal information</strong> such as your Social Security number. We cannot help with individual SSA matters and any such information will be deleted unread.</p>
    </article>
  </div>
</Base>
